# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=5230
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:5230     # what browsers and phones open; Memos also uses it in the links it makes
SSL_PROXY=0                          # 1 behind DSM's reverse proxy with HTTPS
HOST_UID=1026                        # the package's user: Memos writes attachments/ as it
HOST_GID=100
MEMOS_IMAGE=neosmemo/memos:0.31      # Memos 0.31.x: the Updates tab brings its fixes; a newer Memos comes with a package update
ADMIN_USER=you                       # your account (its password is never stored; it's shown once)
DSM_USER=dsm                         # the package's own administrator, for the window
DSM_PASS=…                           # its password, used only to make the token below again if it's lost
DSM_TOKEN=…                          # its access token: the window's work goes through Memos's own API
